<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.myapp">

    <!-- صلاحيات الإنترنت للتحميل -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- صلاحية الرسم فوق التطبيقات -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- صلاحيات الخدمة الأمامية وتصوير الشاشة -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ضروري جداً في أندرويد 11+ عشان التطبيق يقدر يفتح ببجي -->
    <queries>
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.rekoo.pubgm" />
        <package android:name="com.vng.pubgmobile" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Overlay ESP"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- شاشة التطبيق الأساسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- الخدمة اللي بتشتغل في الخلفية لرسم المربعات -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

    </application>
</manifest>