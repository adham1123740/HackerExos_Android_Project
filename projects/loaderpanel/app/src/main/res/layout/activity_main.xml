<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0810"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:elevation="10dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/bg_circle"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PANEL EXOS"
                android:textColor="#00E5FF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVELOPER • @HackerExos"
                android:textColor="#B388FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Shizuku Status -->
        <TextView
            android:id="@+id/tv_shizuku_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shizuku: غير شغال"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>

        <!-- Game Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:background="@drawable/bg_circle"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUBG Mobile | Global"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_package_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جاري البحث..."
                        android:textColor="#888888"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="جاهز للبدء"
                android:textColor="#B0B0B0"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_status"
                android:layout_marginTop="16dp"/>

            <!-- زر التحميل -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ENABLE • تشغيل الهاك"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_btn_start"
                android:layout_marginTop="16dp"/>

            <!-- زر الحذف -->
            <Button
                android:id="@+id/btn_delete_hack"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="REMOVE • حذف الهاك"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1A1025"
                android:layout_marginTop="12dp"/>

            <!-- زر اللعبة -->
            <Button
                android:id="@+id/btn_launch"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="LAUNCH • فتح اللعبة"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:backgroundTint="#0A0810"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#F20A0810"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="300dp"
                android:layout_height="10dp"
                android:progressTint="#D500F9"
                android:max="100"/>

            <TextView
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جاري التحميل..."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="20dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>