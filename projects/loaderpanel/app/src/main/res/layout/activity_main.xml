<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- البطاقة العلوية (اسم المطور) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="25dp"
            android:layout_marginTop="10dp">

            <!-- صورة اللوجو -->
            <ImageView
                android:id="@+id/img_logo_top"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:background="@drawable/btn_purple_outline"
                android:padding="5dp"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المطور احمد"
                android:textColor="#FF4081"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"/>

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="#FF4081"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEON CONTROL • DEVELOPER AHMAD"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- حالة Shizuku -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shizuku: غير شغال 🔴"
            android:textColor="#FF4081"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_purple_outline"
            android:paddingHorizontal="30dp"
            android:paddingVertical="10dp"
            android:layout_marginTop="25dp" />

        <!-- عنوان اللعبة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إصدارات اللعبة • AHMAD EDITION"
            android:textColor="#FF4081"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"/>

        <!-- بطاقة اللعبة والأزرار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- صورة الببجي -->
                <ImageView
                    android:id="@+id/img_pubg_icon"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@drawable/btn_purple_outline"
                    android:padding="3dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="15dp"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ببجي العالمية | Global"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="com.tencent.ig"
                        android:textColor="#AAAAAA"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- شريط الحماية مغلقة -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الحماية مغلقة"
                android:textColor="#FF4081"
                android:textSize="14sp"
                android:gravity="end"
                android:padding="10dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/btn_purple_outline"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"/>

            <!-- زر تفعيل الهاك (لونه بينك) -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ENABLE • تفعيل هاك"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_pink"
                android:layout_marginTop="10dp"/>

            <!-- زر حذف ملف الهاك (إطار بنفسجي) -->
            <Button
                android:id="@+id/btn_delete_hack"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="REMOVE • حذف ملف هاك"
                android:textColor="#FF4081"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_purple_outline"
                android:layout_marginTop="15dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>