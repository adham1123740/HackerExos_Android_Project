<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0514"> <!-- لون خلفية غامق احتياطي -->

    <!-- صورة الخلفية (التي تحتوي على الشعار والتصميم) -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_main" 
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- نصوص الحالة (تظهر فوق التصميم) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shizuku: غير فعال"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="330dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- زر تفعيل الهاك (شفاف فوق تصميم الزر الوردي) -->
    <Button
        android:id="@+id/btn_start"
        android:layout_width="280dp"
        android:layout_height="65dp"
        android:background="@android:color/transparent"
        android:layout_marginBottom="85dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- زر حذف الهاك (شفاف فوق تصميم الزر الشفاف) -->
    <Button
        android:id="@+id/btn_delete_hack"
        android:layout_width="280dp"
        android:layout_height="65dp"
        android:background="@android:color/transparent"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- زر فتح اللعبة (شفاف فوق أيقونة الببجي) -->
    <ImageButton
        android:id="@+id/img_pubg_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@android:color/transparent"
        android:layout_marginTop="480dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>